BBR_STATUS="$BBR_STATUS"
HCR_STATUS="$HCR_STATUS"
BHTTP_UPLOAD="$BHTTP_UPLOAD"
BHTTP_DOWNLOAD="$BHTTP_DOWNLOAD"
BHTTP_BATCH="$BHTTP_BATCH"
PORTS_INITIALIZED="$PORTS_INITIALIZED"
EOF
mv -f "$tmp" "$CONFIG"
}

puerto_valido(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

mostrar_uso_puerto(){
local p="$1" salida=""
salida="$(ss -H -ltnp "sport = :$p" 2>/dev/null || true)"$'\n'"$(ss -H -lunp "sport = :$p" 2>/dev/null || true)"
[ -n "${salida//$'\n'/}" ] && echo "$salida" | sed '/^[[:space:]]*$/d; s/^/    /'
}

puerto_ocupado_por_otro(){
local p="$1" servicio="${2:-}" salida pid
salida="$(ss -H -ltnp "sport = :$p" 2>/dev/null || true)"$'\n'"$(ss -H -lunp "sport = :$p" 2>/dev/null || true)"
salida="$(sed '/^[[:space:]]*$/d' <<< "$salida")"
[ -z "$salida" ] && return 1
if [ -n "$servicio" ]; then
pid="$(systemctl show -p MainPID --value "$servicio" 2>/dev/null || true)"
if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 0 ] && ! grep -qv "pid=$pid," <<< "$salida"; then
  return 1
fi
fi
return 0
}

puerto_disponible(){
local p="$1" servicio="$2" ws_service="${WS_SERVICE:-bhttp-ws}"
puerto_valido "$p" || return 1
if [ "$servicio" != "$SERVICE" ] && [ -n "$PUERTO" ] && systemctl is-active --quiet "$SERVICE" 2>/dev/null && [ "$p" = "$PUERTO" ]; then return 1; fi
if [ "$servicio" != "$ws_service" ] && [ -n "$WSPORT" ] && systemctl is-active --quiet "$ws_service" 2>/dev/null && [ "$p" = "$WSPORT" ]; then return 1; fi
if [ "$servicio" != "$BADVPN_SERVICE" ] && systemctl is-active --quiet "$BADVPN_SERVICE" 2>/dev/null && [ "$p" = "$BADVPN_PORT" ]; then return 1; fi
! puerto_ocupado_por_otro "$p" "$servicio"
}

liberar_puerto_para_panel(){
local p="$1" unidad pid salida=""
if [ "$p" = "22" ] || [ "$p" = "$SSHPORT" ]; then
fail "El puerto SSH $p está protegido y no puede ser tomado por el panel."
return 1
fi
mostrar_uso_puerto "$p"
info "Liberando el puerto $p para el panel..."
while IFS= read -r unidad; do
[ -n "$unidad" ] || continue
pid="$(systemctl show -p MainPID --value "$unidad" 2>/dev/null || true)"
if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 0 ]; then
  salida="$(ss -H -ltnup "sport = :$p" 2>/dev/null || true)"
  if grep -q "pid=$pid," <<< "$salida"; then
    info "Deteniendo $unidad (usa el puerto $p)..."
    systemctl stop "$unidad" >/dev/null 2>&1 || true
    systemctl disable "$unidad" >/dev/null 2>&1 || true
  fi
fi
done < <(systemctl list-units --all --type=service --no-legend --plain 2>/dev/null | awk '{print $1}')

if command -v fuser >/dev/null 2>&1; then
fuser -k -n tcp "$p" >/dev/null 2>&1 || true
fuser -k -n udp "$p" >/dev/null 2>&1 || true
fi
sleep 1
if puerto_ocupado_por_otro "$p"; then
fail "No se pudo liberar el puerto $p. Sigue ocupado por:"
mostrar_uso_puerto "$p"
return 1
fi
ok "Puerto $p liberado para el panel."
}

tomar_puerto_para_panel(){
local p="$1" servicio="$2"
puerto_valido "$p" || return 1
puerto_disponible "$p" "$servicio" && return 0
liberar_puerto_para_panel "$p" || return 1
puerto_disponible "$p" "$servicio"
}

abrir_puerto_sistema(){
local p="$1"
info "Aplicando reglas de firewall para el puerto $p..."
if command -v ufw >/dev/null 2>&1; then
ufw allow "$p"/tcp >/dev/null 2>&1 || true
ufw allow "$p"/udp >/dev/null 2>&1 || true
ufw reload >/dev/null 2>&1 || true
fi
if command -v iptables >/dev/null 2>&1; then
iptables -C INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || iptables -A INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || true
iptables -C INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || iptables -A INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || true
if command -v netfilter-persistent >/dev/null 2>&1; then
  netfilter-persistent save >/dev/null 2>&1 || true
elif [ -d /etc/iptables ]; then
  iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
fi
fi
ok "Puertos y firewall actualizados correctamente."
}

cerrar_puerto_sistema(){
local p="$1"
puerto_valido "$p" || return 0
if command -v ufw >/dev/null 2>&1; then
ufw delete allow "$p"/tcp >/dev/null 2>&1 || true
ufw delete allow "$p"/udp >/dev/null 2>&1 || true
ufw reload >/dev/null 2>&1 || true
fi
if command -v iptables >/dev/null 2>&1; then
while iptables -C INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null; do iptables -D INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || break; done
while iptables -C INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null; do iptables -D INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || break; done
command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1 || true
fi
}

instalar_badvpn(){
local bin=""
for x in /usr/bin/badvpn-udpgw /usr/local/bin/badvpn-udpgw; do
[ -x "$x" ] && { bin="$x"; break; }
done
[ -z "$bin" ] && bin="$(command -v badvpn-udpgw 2>/dev/null || true)"
if [ -z "$bin" ]; then
local log="$CONFIG_DIR/badvpn-install.log"
info "Instalando BadVPN UDP Gateway (solo la primera vez)..."
mkdir -p "$CONFIG_DIR"
if ! command -v add-apt-repository >/dev/null 2>&1; then
  DEBIAN_FRONTEND=noninteractive apt-get update >> "$log" 2>&1 || true
  DEBIAN_FRONTEND=noninteractive apt-get install -y software-properties-common >> "$log" 2>&1 || true
fi
if command -v add-apt-repository >/dev/null 2>&1 && grep -qi '^ID=ubuntu' /etc/os-release 2>/dev/null; then
  add-apt-repository -y universe >> "$log" 2>&1 || true
fi
DEBIAN_FRONTEND=noninteractive apt-get update >> "$log" 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get install -y badvpn iptables-persistent >> "$log" 2>&1 || true
for x in /usr/bin/badvpn-udpgw /usr/local/bin/badvpn-udpgw; do
  [ -x "$x" ] && { bin="$x"; break; }
done
[ -z "$bin" ] && bin="$(command -v badvpn-udpgw 2>/dev/null || true)"
if [ -z "$bin" ]; then
  local src="/usr/local/src/bhttp-badvpn-udpgw"
  info "El paquete no existe en este Ubuntu; preparando BadVPN UDP Gateway..."
  DEBIAN_FRONTEND=noninteractive apt-get install -y git cmake build-essential >> "$log" 2>&1 || true
  rm -rf "$src"
  if git clone --depth 1 https://github.com/ambrop72/badvpn.git "$src" >> "$log" 2>&1 && \
     nice -n 10 cmake -S "$src" -B "$src/build" -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1 >> "$log" 2>&1 && \
     nice -n 10 cmake --build "$src/build" -- -j1 >> "$log" 2>&1 && \
     install -m 0755 "$src/build/udpgw/badvpn-udpgw" /usr/local/bin/badvpn-udpgw >> "$log" 2>&1; then
    bin="/usr/local/bin/badvpn-udpgw"
  fi
fi
fi
if [ -z "$bin" ]; then
fail "No se pudo instalar badvpn-udpgw. Detalle: $CONFIG_DIR/badvpn-install.log"
return 1
fi
cat > "$BADVPN_UNIT" <<EOF
[Unit]
Description=BadVPN UDP Gateway
After=network.target

[Service]
Type=simple
User=root
ExecStart=$bin --listen-addr 0.0.0.0:$BADVPN_PORT --max-clients 500 --max-connections-for-client 50
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
}

