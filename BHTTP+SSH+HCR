}

cargar_config(){
mkdir -p "$CONFIG_DIR"
local existia=0 k v
if [ -f "$CONFIG" ]; then
existia=1
while IFS='=' read -r k v || [ -n "$k" ]; do
  v="${v%$'\r'}"; v="${v%\"}"; v="${v#\"}"
  case "$k" in
    PUERTO|SSHPORT|BADVPN_PORT|BHTTP_UPLOAD|BHTTP_DOWNLOAD|BHTTP_BATCH|PORTS_INITIALIZED)
      [[ "$v" =~ ^[0-9]*$ ]] && printf -v "$k" '%s' "$v" ;;
    BADVPN_STATE|AUTOSTART_STATUS|CRON_STATUS|BBR_STATUS|HCR_STATUS)
      printf -v "$k" '%s' "$v" ;;
  esac
done < "$CONFIG"
fi
: "${PUERTO:=}"; : "${WSPORT:=}"; : "${SSHPORT:=22}"; : "${BADVPN_PORT:=7300}"
: "${BADVPN_STATE:=OFF}"; : "${AUTOSTART_STATUS:=OFF}"
: "${CRON_STATUS:=OFF}"; : "${BBR_STATUS:=OFF}"; : "${HCR_STATUS:=OFF}"
: "${BHTTP_UPLOAD:=8}"; : "${BHTTP_DOWNLOAD:=16}"; : "${BHTTP_BATCH:=6}"
if [ "${PORTS_INITIALIZED:-0}" != "1" ]; then
[ "$existia" = "1" ] || PUERTO=""
PORTS_INITIALIZED=1
guardar_config
fi
}

