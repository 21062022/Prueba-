local tmp="$CONFIG.$$"
cat > "$tmp" <<EOF
PUERTO="$PUERTO"
SSHPORT="$SSHPORT"
BADVPN_PORT="$BADVPN_PORT"
BADVPN_STATE="$BADVPN_STATE"
AUTOSTART_STATUS="$AUTOSTART_STATUS"
