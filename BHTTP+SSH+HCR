while true; do
titulo; seccion "GESTOR DE HCR PLAIN (MULTIPUERTOS)"
local puertos_act st_hcr
puertos_act="$(hcr_obtener_puertos_activos)"
if systemctl is-active --quiet hcr 2>/dev/null; then
  st_hcr="${NEON_GREEN}ACTIVO${RESET}"
  HCR_STATUS="ON"
else
  st_hcr="${RED}INACTIVO${RESET}"
  HCR_STATUS="OFF"
fi
echo -e "  ${WHITE}Estado Actual   :${RESET} $st_hcr"
echo -e "  ${WHITE}Puertos Activos :${RESET} ${NEON_ORANGE}${puertos_act}${RESET}"
echo -e "  ${GRAY}Usa las mismas cuentas de usuario de tu panel (destino SSH 127.0.0.1:${SSHPORT}).${RESET}"
linea
echo -e "  ${NEON_GREEN}[1]${RESET} Instalar / Configurar Puerto(s) HCR Plain"
echo -e "  ${NEON_GREEN}[2]${RESET} Agregar un Puerto Extra en Caliente"
echo -e "  ${NEON_GREEN}[3]${RESET} Encender / Apagar HCR (conservando puertos)"
echo -e "  ${RED}[4]${RESET} Desinstalar HCR y Liberar Todos los Puertos"
echo -e "  ${RED}[0]${RESET} Volver al Menú Principal"
linea
read -r -p "$(echo -e " ${NEON_ORANGE}◆${RESET} Selecciona una opción: ")" opcion

case "$opcion" in
  1)
    if ! hcr_asegurar_binario; then pausa; continue; fi
    ws_preparar_sshd >/dev/null 2>&1 || true

    echo
    info "Puedes ingresar un puerto (ej: 8880) o varios separados por coma o espacio (ej: 8880, 2052)."
    while true; do
      read -r -p "$(echo -e " ${NEON_ORANGE}◆${RESET} Puerto(s) de escucha [Default $HCR_DEFAULT_PORT]: ")" INPUT_PORTS
      INPUT_PORTS=${INPUT_PORTS:-$HCR_DEFAULT_PORT}
      CLEAN_PORTS=$(echo "$INPUT_PORTS" | tr ',' ' ' | xargs -n1 2>/dev/null | awk '!seen[$0]++')

      VALID_LIST=()
      ERROR_PORT=0

      hcr_detener_instancias

      for p in $CLEAN_PORTS; do
        if ! [[ "$p" =~ ^[0-9]+$ ]] || (( p < 1 || p > 65535 )); then
          fail "Puerto inválido: $p (Debe ser entre 1 y 65535)."
          ERROR_PORT=1
          break
        fi
        if ss -tuln 2>/dev/null | grep -qE ":$p\b" || netstat -tuln 2>/dev/null | grep -qE ":$p\b"; then
          fail "El puerto $p ya está siendo usado por otro servicio."
          mostrar_uso_puerto "$p"
          ERROR_PORT=1
          break
        fi
        VALID_LIST+=("$p")
      done

      if [ "$ERROR_PORT" -eq 0 ] && [ "${#VALID_LIST[@]}" -gt 0 ]; then
        break
      fi
    done

    info "Configurando HCR Plain (Frame $(hcr_detectar_frame_optimo)B) en puerto(s): ${VALID_LIST[*]}..."
    hcr_aplicar_puertos "${VALID_LIST[@]}"
    sleep 2

    if systemctl is-active --quiet hcr 2>/dev/null; then
      HCR_STATUS="ON"
      guardar_config
      ok "HCR Plain operando con éxito en: $(hcr_obtener_puertos_activos)"
    else
      HCR_STATUS="OFF"
      guardar_config
      fail "El servicio HCR no pudo iniciar."
      journalctl -u hcr -n 10 --no-pager 2>/dev/null || true
    fi
    pausa ;;
  2)
    if [ ! -s "$HCR_BIN" ]; then
      fail "Primero instala HCR desde la opción 1."
      pausa; continue
    fi
    read -r -p "$(echo -e "\n ${NEON_ORANGE}◆${RESET} Ingresa el nuevo puerto adicional a abrir: ")" NEW_P
    if ! [[ "$NEW_P" =~ ^[0-9]+$ ]] || (( NEW_P < 1 || NEW_P > 65535 )); then
      fail "Puerto inválido."
      pausa; continue
    fi
    if ss -tuln 2>/dev/null | grep -qE ":$NEW_P\b" || netstat -tuln 2>/dev/null | grep -qE ":$NEW_P\b"; then
      fail "El puerto $NEW_P ya está en uso."
      mostrar_uso_puerto "$NEW_P"
      pausa; continue
    fi

    EXISTING_PORTS=""
    [ -f "$PORTS_FILE" ] && EXISTING_PORTS=$(cat "$PORTS_FILE" 2>/dev/null || true)
    ALL_PORTS=$(echo "$EXISTING_PORTS $NEW_P" | xargs -n1 2>/dev/null | awk '!seen[$0]++')
    read -r -a ARR_PORTS <<< "$ALL_PORTS"

    hcr_aplicar_puertos "${ARR_PORTS[@]}"
    sleep 2
    HCR_STATUS="ON"
    guardar_config
    ok "Puerto $NEW_P agregado. Puertos activos: $(hcr_obtener_puertos_activos)"
    pausa ;;
  3)
    if systemctl is-active --quiet hcr 2>/dev/null; then
      for srv in /etc/systemd/system/hcr-*.service; do
        [ -f "$srv" ] && systemctl stop "$(basename "$srv")" >/dev/null 2>&1 || true
      done
      systemctl stop hcr >/dev/null 2>&1 || true
      HCR_STATUS="OFF"
      guardar_config
      ok "HCR apagado (se conservaron los puertos guardados en ports.conf)."
    else
      if ! [ -s "$PORTS_FILE" ]; then
        fail "No hay puertos configurados todavía. Usa la opción 1 primero."
      elif ! hcr_asegurar_binario; then
        :
      else
        read -r -a ARR_PORTS < "$PORTS_FILE"
        hcr_aplicar_puertos "${ARR_PORTS[@]}"
        sleep 1
        if systemctl is-active --quiet hcr 2>/dev/null; then
          HCR_STATUS="ON"
          guardar_config
          ok "HCR encendido en: $(hcr_obtener_puertos_activos)"
        else
          fail "No pudo encender HCR."
        fi
      fi
    fi
    pausa ;;
  4)
    info "Desinstalando HCR y liberando todos los puertos..."
    hcr_detener_instancias
    rm -rf "$HCR_DIR" "$PORTS_FILE"
    HCR_STATUS="OFF"
    guardar_config
    ok "HCR desinstalado correctamente."
    pausa ;;
  0) return ;;
  *) fail "Opción inválida."; pausa ;;
esac
done
}

# === PARCHE HAZAEL v2 (opciones 6,7,8,9,11 + panel profesional) ===============

AUTOSTART_MARK_INI="# >>> BHTTP-AUTOSTART >>>"
AUTOSTART_MARK_FIN="# <<< BHTTP-AUTOSTART <<<"
CRON_FILE="/etc/cron.d/bhttp-optimizer"
OPT_BIN="/usr/local/bin/bhttp-optimize.sh"
OPT_LOG="/var/log/bhttp-optimize.log"

ram_info(){
free -m 2>/dev/null | awk '/^Mem:/{t=$2; a=$7; if(a=="")a=$4; u=t-a; p=(t>0)?u*100/t:0; printf "%d %d %d", u, t, p}'
}

cpu_uso_real(){
local _ u1 n1 s1 i1 iw1 ir1 si1 st1 u2 n2 s2 i2 iw2 ir2 si2 st2 t1 t2 idle1 idle2
read -r _ u1 n1 s1 i1 iw1 ir1 si1 st1 _ < /proc/stat 2>/dev/null || { echo 0; return; }
sleep 0.15
read -r _ u2 n2 s2 i2 iw2 ir2 si2 st2 _ < /proc/stat 2>/dev/null || { echo 0; return; }
t1=$((u1+n1+s1+i1+iw1+ir1+si1+st1)); t2=$((u2+n2+s2+i2+iw2+ir2+si2+st2))
idle1=$((i1+iw1)); idle2=$((i2+iw2))
awk -v dt="$((t2-t1))" -v di="$((idle2-idle1))" 'BEGIN { if(dt<=0) print 0; else { p=(dt-di)*100/dt; if(p<0)p=0; if(p>100)p=100; printf "%d",p } }'
}

barra_uso(){
local pct="${1:-0}" n i out="" color
[[ "$pct" =~ ^[0-9]+$ ]] || pct=0
[ "$pct" -gt 100 ] && pct=100
n=$((pct/10))
if [ "$pct" -lt 60 ]; then color="$NEON_GREEN"
elif [ "$pct" -lt 85 ]; then color="$NEON_ORANGE"
else color="$RED"; fi
for ((i=0; i<10; i++)); do
if [ "$i" -lt "$n" ]; then out+="█"; else out+="░"; fi
done
echo -e "${color}${out}${RESET} ${WHITE}${pct}%${RESET}"
}

estado_servicio(){
if systemctl is-active --quiet "$1" 2>/dev/null; then
echo "${NEON_GREEN}● ACTIVO${RESET}"
else
echo "${RED}○ DETENIDO${RESET}"
fi
}

onoff(){
if [ "$1" = "ON" ]; then echo "${NEON_GREEN}● ACTIVADO${RESET}"; else echo "${RED}○ DESACTIVADO${RESET}"; fi
}

fila_panel(){
printf "  ${NEON_BLUE}│${RESET} ${GRAY}%-18s${RESET} %b\n" "$1" "$2"
}

autostart_activo(){ grep -qs "BHTTP-AUTOSTART >>>" /root/.bashrc; }
cron_activo(){ [ -f "$CRON_FILE" ]; }

refrescar_estados(){
if autostart_activo; then AUTOSTART_STATUS="ON"; else AUTOSTART_STATUS="OFF"; fi
if cron_activo; then CRON_STATUS="ON"; else CRON_STATUS="OFF"; fi
if systemctl is-active --quiet "$BADVPN_SERVICE" 2>/dev/null; then BADVPN_STATE="ON"; else BADVPN_STATE="OFF"; fi
if systemctl is-active --quiet hcr 2>/dev/null; then HCR_STATUS="ON"; else HCR_STATUS="OFF"; fi
}

resumen_usuarios(){
local -A con=()
local u c
TOTAL_U=0; ONLINE_U=0; TOTAL_C=0
while read -r u c; do
[ -n "$u" ] || continue
[[ "$c" =~ ^[0-9]+$ ]] || continue
con["$u"]="$c"
done < <(obtener_conexiones_ssh)
while read -r u; do
[ -n "$u" ] || continue
TOTAL_U=$((TOTAL_U+1))
if [ "${con[$u]:-0}" -gt 0 ]; then
  ONLINE_U=$((ONLINE_U+1))
  TOTAL_C=$((TOTAL_C+${con[$u]}))
fi
done < <(obtener_usuarios_panel | sort -u)
}

panel_estado(){
local up load cpu_n cpu_p ram_u ram_t ram_p disco_p disco_t perf cron_lbl="" hcr_pts=""
up="$(uptime -p 2>/dev/null | sed -E 's/^up //; s/ weeks?/ sem/; s/ days?/ d/; s/ hours?/ h/; s/ minutes?/ min/')"
[ -n "$up" ] || up="N/D"
load="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null || echo 0)"
cpu_n="$(nproc 2>/dev/null || echo 1)"
cpu_p="$(cpu_uso_real)"
read -r ram_u ram_t ram_p <<< "$(ram_info)"
: "${ram_u:=0}"; : "${ram_t:=0}"; : "${ram_p:=0}"
disco_p="$(df -P / 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')"
disco_t="$(df -hP / 2>/dev/null | awk 'NR==2{print $3"/"$2}')"
: "${disco_p:=0}"; : "${disco_t:=N/D}"

case "$(cat "$CONFIG_DIR/bhttp-performance.state" 2>/dev/null)" in
speed)  perf="${NEON_GREEN}VELOCIDAD PURA${RESET}" ;;
stable) perf="${NEON_GREEN}ESTABILIDAD${RESET}" ;;
*)      perf="${RED}APAGADO${RESET}" ;;
esac
if [ "$CRON_STATUS" = "ON" ]; then
cron_lbl="$(grep -oP 'INTERVALO: \K.*' "$CRON_FILE" 2>/dev/null | head -n1)"
fi
hcr_pts="$(hcr_obtener_puertos_activos)"

resumen_usuarios

echo -e "  ${NEON_BLUE}┌─ ${WHITE}${BOLD}SISTEMA${RESET} ${NEON_BLUE}──────────────────────────────────────────────────${RESET}"
fila_panel "Tiempo activo" "${WHITE}${up}${RESET}"
fila_panel "CPU" "$(barra_uso "$cpu_p") ${GRAY}carga ${load} • ${cpu_n} núcleo(s)${RESET}"
fila_panel "Memoria RAM" "$(barra_uso "$ram_p") ${GRAY}${ram_u}/${ram_t} MB${RESET}"
fila_panel "Disco" "$(barra_uso "$disco_p") ${GRAY}${disco_t}${RESET}"
echo -e "  ${NEON_BLUE}├─ ${WHITE}${BOLD}SERVICIOS${RESET} ${NEON_BLUE}────────────────────────────────────────────────${RESET}"
fila_panel "BHTTP" "$(estado_servicio "$SERVICE")  ${GRAY}Puerto${RESET} ${NEON_GREEN}${PUERTO:-SIN ASIGNAR}${RESET}"
fila_panel "SSH backend" "${GRAY}Puerto${RESET} ${NEON_GREEN}${SSHPORT}${RESET}"
ws_fila_panel
fila_panel "HCR Plain" "$(estado_servicio "hcr")  ${GRAY}Puertos${RESET} ${NEON_GREEN}${hcr_pts}${RESET}"
echo -e "  ${NEON_BLUE}├─ ${WHITE}${BOLD}USUARIOS${RESET} ${NEON_BLUE}─────────────────────────────────────────────────${RESET}"
fila_panel "Registrados" "${WHITE}${BOLD}${TOTAL_U}${RESET}   ${NEON_GREEN}🟢 En línea:${RESET} ${WHITE}${BOLD}${ONLINE_U}${RESET}   ${NEON_ORANGE}📱 Dispositivos:${RESET} ${WHITE}${BOLD}${TOTAL_C}${RESET}"
echo -e "  ${NEON_BLUE}├─ ${WHITE}${BOLD}AUTOMATIZACIÓN${RESET} ${NEON_BLUE}───────────────────────────────────────────${RESET}"
fila_panel "Auto inicio" "$(onoff "$AUTOSTART_STATUS")"
fila_panel "Auto optimización" "$(onoff "$CRON_STATUS") ${GRAY}${cron_lbl}${RESET}"
fila_panel "Rendimiento red" "$perf"
echo -e "  ${NEON_BLUE}└──────────────────────────────────────────────────────────────${RESET}"
echo
}

optimizar_sistema(){
sync
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
if command -v journalctl >/dev/null 2>&1; then
journalctl --vacuum-size=64M >/dev/null 2>&1 || true
fi
apt-get clean >/dev/null 2>&1 || true
find /var/log -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -delete 2>/dev/null || true
}

ejecutar_optimizacion_manual(){
local antes despues liberado
antes="$(free -m 2>/dev/null | awk '/^Mem:/{a=$7; if(a=="")a=$4; print $2-a}')"
: "${antes:=0}"
optimizar_sistema
despues="$(free -m 2>/dev/null | awk '/^Mem:/{a=$7; if(a=="")a=$4; print $2-a}')"
: "${despues:=0}"
liberado=$((antes-despues)); [ "$liberado" -lt 0 ] && liberado=0
info "RAM en uso antes:   ${antes} MB"
info "RAM en uso después: ${despues} MB"
ok "Optimización completada. Liberado aprox.: ${liberado} MB"
}

crear_script_optimizador(){
cat > "$OPT_BIN" <<'OPTEOF'
#!/usr/bin/env bash
sync
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
journalctl --vacuum-size=64M >/dev/null 2>&1
apt-get clean >/dev/null 2>&1
find /var/log -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -delete 2>/dev/null
echo "$(date '+%F %T') optimizacion ejecutada" >> /var/log/bhttp-optimize.log
tail -n 200 /var/log/bhttp-optimize.log > /var/log/bhttp-optimize.log.tmp 2>/dev/null && mv -f /var/log/bhttp-optimize.log.tmp /var/log/bhttp-optimize.log
exit 0
OPTEOF
chmod +x "$OPT_BIN"
}

asegurar_cron(){
if ! systemctl is-active --quiet cron 2>/dev/null && ! systemctl is-active --quiet crond 2>/dev/null && ! pgrep -x cron >/dev/null 2>&1 && ! pgrep -x crond >/dev/null 2>&1; then
info "Instalando/iniciando el servicio cron..."
apt-get install -y cron >/dev/null 2>&1 || true
systemctl enable cron >/dev/null 2>&1 || systemctl enable crond >/dev/null 2>&1 || true
systemctl start cron >/dev/null 2>&1 || systemctl start crond >/dev/null 2>&1 || true
fi
systemctl is-active --quiet cron 2>/dev/null || systemctl is-active --quiet crond 2>/dev/null || pgrep -x cron >/dev/null 2>&1 || pgrep -x crond >/dev/null 2>&1
}

activar_cron(){
local expr="$1" etiqueta="$2"
if ! asegurar_cron; then fail "No se pudo activar el servicio cron."; return 1; fi
crear_script_optimizador
cat > "$CRON_FILE" <<CRONEOF
# INTERVALO: $etiqueta
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
$expr root $OPT_BIN >/dev/null 2>&1
CRONEOF
chmod 644 "$CRON_FILE"
CRON_STATUS="ON"; guardar_config
ok "Optimización automática activada: $etiqueta."
}

menu_optimizacion_automatica(){
while true; do
refrescar_estados
titulo; seccion "OPTIMIZACIÓN AUTOMÁTICA"
local lbl=""
if cron_activo; then lbl="$(grep -oP 'INTERVALO: \K.*' "$CRON_FILE" 2>/dev/null | head -n1)"; fi
echo -e "  ${WHITE}Estado:${RESET} $(onoff "$CRON_STATUS") ${GRAY}${lbl}${RESET}"
echo -e "  ${GRAY}Libera caché de RAM, limpia logs viejos y caché de apt.${RESET}"
echo -e "  ${GRAY}No reinicia BHTTP ni corta a los usuarios conectados.${RESET}"; linea
echo -e "  ${NEON_GREEN}[1]${RESET} Cada 30 minutos"
echo -e "  ${NEON_GREEN}[2]${RESET} Cada hora"
echo -e "  ${NEON_GREEN}[3]${RESET} Cada 6 horas"
echo -e "  ${NEON_GREEN}[4]${RESET} Cada 24 horas (4:00 AM)"
echo -e "  ${NEON_GREEN}[5]${RESET} Ejecutar optimización ahora"
echo -e "  ${RED}[6]${RESET} Desactivar optimización automática"
echo -e "  ${RED}[0]${RESET} Regresar"; linea
read -r -p "$(echo -e " ${NEON_ORANGE}◆${RESET} Opción: ")" op
case "$op" in
  1) activar_cron "*/30 * * * *" "Cada 30 minutos"; pausa ;;
  2) activar_cron "0 * * * *" "Cada hora"; pausa ;;
  3) activar_cron "0 */6 * * *" "Cada 6 horas"; pausa ;;
  4) activar_cron "0 4 * * *" "Cada 24 horas (4:00 AM)"; pausa ;;
  5) ejecutar_optimizacion_manual; pausa ;;
  6)
    rm -f "$CRON_FILE"
    CRON_STATUS="OFF"; guardar_config
    ok "Optimización automática desactivada."; pausa ;;
  0) return ;;
  *) fail "Opción inválida."; pausa ;;
esac
done
}

menu_autostart(){
while true; do
refrescar_estados
titulo; seccion "AUTO INICIAR SCRIPT"
echo -e "  ${WHITE}Estado:${RESET} $(onoff "$AUTOSTART_STATUS")"
echo -e "  ${GRAY}ACTIVAR: BHTTP/BadVPN/HCR arrancan con el VPS y el panel se abre${RESET}"
echo -e "  ${GRAY}automáticamente cuando entras por SSH como root.${RESET}"; linea
echo -e "  ${NEON_GREEN}[1]${RESET} Activar auto inicio"
echo -e "  ${RED}[2]${RESET} Desactivar apertura automática del panel"
echo -e "  ${RED}[0]${RESET} Regresar"; linea
read -r -p "$(echo -e " ${NEON_ORANGE}◆${RESET} Opción: ")" op
case "$op" in
  1)
    systemctl enable "$SERVICE" >/dev/null 2>&1 || true
    [ -f "$BADVPN_UNIT" ] && [ "$BADVPN_STATE" = "ON" ] && systemctl enable "$BADVPN_SERVICE" >/dev/null 2>&1
    [ -f /etc/systemd/system/hcr.service ] && systemctl enable hcr >/dev/null 2>&1 || true
    touch /root/.bashrc
    sed -i '/BHTTP-AUTOSTART >>>/,/BHTTP-AUTOSTART <<</d' /root/.bashrc 2>/dev/null || true
    cat >> /root/.bashrc <<'AEOF'
# >>> BHTTP-AUTOSTART >>>
if [ -t 0 ] && [ -t 1 ] && [ -z "$BHTTP_PANEL" ] && [ -f /usr/local/bin/intalar.sh ]; then
export BHTTP_PANEL=1
bash /usr/local/bin/intalar.sh
fi
# <<< BHTTP-AUTOSTART <<<
AEOF
    AUTOSTART_STATUS="ON"; guardar_config
    ok "Auto inicio activado (servicios al arranque + panel al entrar)."
    pausa ;;
  2)
    sed -i '/BHTTP-AUTOSTART >>>/,/BHTTP-AUTOSTART <<</d' /root/.bashrc 2>/dev/null || true
    AUTOSTART_STATUS="OFF"; guardar_config
    ok "El panel ya no se abre solo. (Los servicios siguen activos al arranque)"
    pausa ;;
  0) return ;;
  *) fail "Opción inválida."; pausa ;;
esac
done
}

GH_MOTIVO=""
descargar_github(){
local url="$1" out="$2" cand code rc errf fam lista
local -a args
errf="$(mktemp /tmp/intalar.err.XXXXXX)" || errf=/dev/null
GH_MOTIVO="sin conexión"
lista="$url"
case "$url" in
*/main/*)   lista+=$'\n'"${url/\/main\//\/master\/}" ;;
*/master/*) lista+=$'\n'"${url/\/master\//\/main\/}" ;;
esac
while IFS= read -r cand; do
[ -n "$cand" ] || continue
if command -v curl >/dev/null 2>&1; then
  for fam in 0 1; do
    args=(); [ "$fam" = "1" ] && args=(-4)
    code="$(curl "${args[@]}" -sS -L --connect-timeout 10 --max-time 60 -H 'Cache-Control: no-cache' \
            -w '%{http_code}' -o "$out" "${cand}?nocache=$(date +%s)" 2>"$errf")"; rc=$?
    if [ "$rc" -eq 0 ] && [ "$code" = "200" ] && [ -s "$out" ]; then rm -f "$errf"; return 0; fi
    if [ "$rc" -ne 0 ]; then
      case "$rc" in
        6)  GH_MOTIVO="el VPS no resuelve el nombre (DNS) de ${cand%%/*/*}" ;;
        7)  GH_MOTIVO="no se pudo conectar con GitHub (sin ruta/firewall)" ;;
        28) GH_MOTIVO="se agotó el tiempo de espera de GitHub" ;;
        35|51|58|59|60|77) GH_MOTIVO="error de certificado SSL (revisa la fecha/hora del VPS y ca-certificates)" ;;
        *)  GH_MOTIVO="curl código $rc: $(head -c 120 "$errf" 2>/dev/null)" ;;
      esac
    else
      case "$code" in
        404) GH_MOTIVO="GitHub responde 404: el archivo o la rama no existe, o el repositorio es PRIVADO ($cand)" ;;
        403|429) GH_MOTIVO="GitHub bloqueó/limitó la descarga (HTTP $code); intenta en unos minutos" ;;
        *)   GH_MOTIVO="GitHub respondió HTTP $code ($cand)" ;;
      esac
      break
    fi
  done
elif command -v wget >/dev/null 2>&1; then
  if wget -q -T 30 -O "$out" "${cand}?nocache=$(date +%s)" 2>"$errf" && [ -s "$out" ]; then rm -f "$errf"; return 0; fi
  GH_MOTIVO="wget no pudo descargar ($cand)"
fi
done <<< "$lista"
rm -f "$errf" 2>/dev/null
return 1
}

actualizar_script(){
titulo; seccion "ACTUALIZAR SCRIPT DESDE GITHUB"
local tmp fn faltan="" resp nueva motivo=""
mkdir -p "$CONFIG_DIR"
[ -s "$GITHUB_URL_FILE" ] && GITHUB_URL="$(head -n1 "$GITHUB_URL_FILE" | tr -d '\r[:space:]')"
if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
info "Instalando curl..."
DEBIAN_FRONTEND=noninteractive apt-get install -y curl >/dev/null 2>&1 || true
fi
if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
fail "No hay curl ni wget y no se pudo instalar ninguno."; pausa; return 1
fi
tmp="$(mktemp /tmp/intalar.XXXXXX)" || { fail "No se pudo crear archivo temporal."; pausa; return 1; }
info "Origen: $GITHUB_URL"
info "Descargando última versión..."
if ! descargar_github "$GITHUB_URL" "$tmp"; then
fail "No se pudo descargar: $GH_MOTIVO"
echo -e "  ${GRAY}Revisa: repositorio PÚBLICO, nombre de rama y de archivo correctos, y que el VPS tenga internet.${RESET}"
read -r -p "$(echo -e " ${NEON_ORANGE}◆${RESET} Pega la URL «raw» correcta de tu script (Enter = cancelar): ")" nueva
nueva="$(printf '%s' "$nueva" | tr -d '\r[:space:]')"
if [ -z "$nueva" ]; then info "Actualización cancelada."; rm -f "$tmp"; pausa; return 1; fi
if descargar_github "$nueva" "$tmp"; then
  printf '%s\n' "$nueva" > "$GITHUB_URL_FILE"; GITHUB_URL="$nueva"
  ok "Descarga correcta. URL guardada para próximas actualizaciones."
else
  fail "Tampoco funcionó: $GH_MOTIVO"; rm -f "$tmp"; pausa; return 1
fi
fi
sed -i 's/\r$//' "$tmp" 2>/dev/null || true
sed -i '1s/^\xEF\xBB\xBF//' "$tmp" 2>/dev/null || true
if ! head -n1 "$tmp" | grep -q '^#!.*bash'; then
fail "El archivo descargado no parece un script bash (¿repo privado o URL incorrecta?)."
rm -f "$tmp"; pausa; return 1
fi
if grep -q 'BLOQUE_NUEVO''_EOF' "$tmp"; then motivo="contiene un parche en vez del script completo"
elif ! grep -q 'HAZAEL MORENO MULTI SCRIPT' "$tmp"; then motivo="falta el título «HAZAEL MORENO MULTI SCRIPT»"
elif ! grep -q 'PYEOF' "$tmp"; then motivo="falta el servidor BHTTP (PYEOF)"
elif ! grep -qE '^instalar_servidor\(\)' "$tmp"; then motivo="falta la función instalar_servidor"
elif ! grep -qE '^check_root$' "$tmp"; then motivo="falta la llamada final check_root"
fi
if [ -n "$motivo" ]; then
fail "El archivo de GitHub NO es el script completo: $motivo."
info "Tu panel actual no fue modificado."
rm -f "$tmp"; pausa; return 1
fi
if ! bash -n "$tmp" 2>/dev/null; then
fail "La versión de GitHub tiene errores de sintaxis. No se aplicó:"
bash -n "$tmp" 2>&1 | head -n 3 | sed 's/^/    /'
rm -f "$tmp"; pausa; return 1
fi
if [ -f "$SCRIPT_PATH" ] && cmp -s "$tmp" "$SCRIPT_PATH"; then
ok "Ya tienes la última versión."
rm -f "$tmp"; pausa; return 0
fi
for fn in actualizar_script menu_autostart menu_optimizacion_automatica ejecutar_optimizacion_manual destruir_script_total; do
grep -qE "^${fn}\(\)" "$tmp" || faltan+=" $fn"
done
if [ -n "$faltan" ]; then
