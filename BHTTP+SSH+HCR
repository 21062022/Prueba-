configurar_atajo_adm(){
if [ "$0" != "$SCRIPT_PATH" ] && [ -f "$0" ]; then
cp "$0" "$SCRIPT_PATH" 2>/dev/null || true
fi
chmod +x "$SCRIPT_PATH" 2>/dev/null || true
cat > "$ADM_BIN" <<'EOF'
#!/usr/bin/env bash
exec sudo bash /usr/local/bin/intalar.sh "$@"
EOF
cat > "$ADMIN_BIN" <<'EOF'
#!/usr/bin/env bash
exec sudo bash /usr/local/bin/intalar.sh "$@"
EOF
chmod +x "$ADM_BIN" "$ADMIN_BIN"
local cmd destino respaldo
for cmd in adm admin; do
for destino in "/usr/bin/$cmd" "/bin/$cmd"; do
  if [ -e "$destino" ] && ! grep -qs 'BHTTP-PANEL-COMMAND' "$destino"; then
    respaldo="$CONFIG_DIR/${cmd}.comando-anterior"
    [ -e "$respaldo" ] || cp -a "$destino" "$respaldo" 2>/dev/null || true
  fi
  cat > "$destino" <<EOF
#!/usr/bin/env bash
# BHTTP-PANEL-COMMAND
exec sudo bash /usr/local/bin/intalar.sh "\$@"
EOF
  chmod +x "$destino" 2>/dev/null || true
