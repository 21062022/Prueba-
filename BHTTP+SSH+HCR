read -r -p "$(echo -e " ${NEON_ORANGE}◆${RESET} Puerto WebSocket (1-65535): ")" nuevo
if [ -n "$nuevo" ]; then
if puerto_valido "$nuevo" && tomar_puerto_para_panel "$nuevo" "$WS_SERVICE"; then
  WSPORT="$nuevo"
else
  fail "Puerto inválido, repetido o usado por otro servicio."
  mostrar_uso_puerto "$nuevo"; pausa; return 1
fi
elif [ -z "$WSPORT" ]; then
fail "Debes indicar un puerto para activar WebSocket."; pausa; return 1
fi
if ws_puerto_ocupado "$WSPORT"; then
fail "El puerto $WSPORT está en uso por otro programa:"
mostrar_uso_puerto "$WSPORT"
info "Apaga ese servicio (nginx/apache) o elige otro puerto."
pausa; return 1
fi

info "Preparando SSH (contraseñas + túneles)..."
ws_preparar_sshd || true
info "Escribiendo proxy..."
ws_escribir_proxy || { fail "Error de sintaxis en el proxy Python."; pausa; return 1; }
ws_escribir_unit
systemctl enable "$WS_SERVICE" >/dev/null 2>&1 || true
systemctl restart "$WS_SERVICE" >/dev/null 2>&1 || true
