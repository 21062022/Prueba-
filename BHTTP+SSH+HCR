hcr_obtener_puertos_activos(){
local pts
pts=$(ss -tulnp 2>/dev/null | grep '"hcr-server"' | awk '{print $5}' | awk -F: '{print $NF}' | sort -n -u | paste -sd "," - | sed 's/,/, /g')
[[ -z "$pts" ]] && pts=$(netstat -tulnp 2>/dev/null | grep "hcr-server" | awk '{print $4}' | awk -F: '{print $NF}' | sort -n -u | paste -sd "," - | sed 's/,/, /g')
echo "${pts:-Ninguno}"
}

hcr_asegurar_binario(){
mkdir -p "$HCR_DIR" "/etc/vps-manager/core"
if [ -s "$HCR_BIN" ] && ! grep -q "404: Not Found" "$HCR_BIN" 2>/dev/null; then
cp -f "$HCR_BIN" "$CORE_BIN" 2>/dev/null || true
elif [ -s "$CORE_BIN" ] && ! grep -q "404: Not Found" "$CORE_BIN" 2>/dev/null; then
cp -f "$CORE_BIN" "$HCR_BIN"
elif [ -s "/tmp/revisar_hcr/hcr-server" ]; then
cp -f "/tmp/revisar_hcr/hcr-server" "$CORE_BIN"
cp -f "/tmp/revisar_hcr/hcr-server" "$HCR_BIN"
elif [ -s "/root/hcr/hcr-server" ]; then
cp -f "/root/hcr/hcr-server" "$CORE_BIN"
cp -f "/root/hcr/hcr-server" "$HCR_BIN"
else
local base_repo="${REPO_URL:-}"
[ -z "$base_repo" ] && [ -s "$GITHUB_URL_FILE" ] && base_repo="$(dirname "$(head -n1 "$GITHUB_URL_FILE" | tr -d '\r[:space:]')")"
[ -z "$base_repo" ] && base_repo="$(dirname "$GITHUB_URL")"
local url
for url in "${base_repo}/core/hcr-server" "${base_repo}/hcr-server"; do
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 10 --retry 2 "$url" -o "${HCR_BIN}.tmp" 2>/dev/null || true
  elif command -v wget >/dev/null 2>&1; then
    wget -4 -T 10 -t 2 -qO "${HCR_BIN}.tmp" "$url" 2>/dev/null || true
  fi
  if [ -s "${HCR_BIN}.tmp" ] && ! grep -q "404: Not Found" "${HCR_BIN}.tmp" 2>/dev/null; then
    mv -f "${HCR_BIN}.tmp" "$HCR_BIN"
    cp -f "$HCR_BIN" "$CORE_BIN" 2>/dev/null || true
    break
  else
    rm -f "${HCR_BIN}.tmp" 2>/dev/null || true
  fi
done
fi

chmod 0755 "$HCR_BIN" "$CORE_BIN" 2>/dev/null || true
if [ ! -s "$HCR_BIN" ] || grep -q "404: Not Found" "$HCR_BIN" 2>/dev/null; then
rm -f "$HCR_BIN" 2>/dev/null || true
fail "No se encontró el binario 'hcr-server' en el VPS ni en el repositorio."
info "Copia hcr-server a /etc/vps-manager/core/hcr-server o súbelo a tu GitHub."
return 1
fi
return 0
}

hcr_detectar_frame_optimo(){
local frame="$HCR_DEFAULT_FRAME"
local help_out
help_out="$("$HCR_BIN" --help 2>&1 || true)"
if [[ "$help_out" =~ frame\ range:\ 1-([0-9]+) ]]; then
local max_supported="${BASH_REMATCH[1]}"
if (( frame > max_supported )); then
  frame="$max_supported"
fi
else
frame=16384
fi
echo "$frame"
}

hcr_detener_instancias(){
local p_prev=""
[ -f "$PORTS_FILE" ] && p_prev="$(cat "$PORTS_FILE" 2>/dev/null || true)"
systemctl stop hcr >/dev/null 2>&1 || true
systemctl disable hcr >/dev/null 2>&1 || true
for srv in /etc/systemd/system/hcr-*.service; do
[ -f "$srv" ] || continue
local sname
sname=$(basename "$srv")
systemctl stop "$sname" >/dev/null 2>&1 || true
systemctl disable "$sname" >/dev/null 2>&1 || true
rm -f "$srv"
done
systemctl stop hcr-server.service >/dev/null 2>&1 || true
systemctl disable hcr-server.service >/dev/null 2>&1 || true
rm -f /etc/systemd/system/hcr-server.service /etc/systemd/system/hcr.service
pkill -9 -x "hcr-server" >/dev/null 2>&1 || true
systemctl daemon-reload
for p in $p_prev; do
[ "$p" != "$PUERTO" ] && [ "$p" != "$WSPORT" ] && [ "$p" != "$BADVPN_PORT" ] && cerrar_puerto_sistema "$p"
done
}

hcr_aplicar_puertos(){
local lista_puertos=("$@")
local frame_size
frame_size=$(hcr_detectar_frame_optimo)
local ssh_target="127.0.0.1:${SSHPORT:-22}"

hcr_detener_instancias

local main_port="${lista_puertos[0]}"
mkdir -p "$HCR_DIR"
echo "${lista_puertos[*]}" > "$PORTS_FILE"

cat << SERVICE_EOF > /etc/systemd/system/hcr.service
[Unit]
Description=HCR Plain Server (Main Port $main_port)
After=network.target ssh.service sshd.service

[Service]
Type=simple
User=root
WorkingDirectory=$HCR_DIR
ExecStart=$HCR_BIN --listen :$main_port --target $ssh_target --transport $HCR_TRANSPORT --max-download-frame $frame_size --download-poll-timeout $HCR_POLL_TIMEOUT
LimitNOFILE=65535
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
SERVICE_EOF

systemctl daemon-reload
systemctl enable hcr >/dev/null 2>&1 || true
systemctl reset-failed hcr >/dev/null 2>&1 || true
systemctl restart hcr
abrir_puerto_sistema "$main_port"

if [ "${#lista_puertos[@]}" -gt 1 ]; then
for (( i=1; i<${#lista_puertos[@]}; i++ )); do
  local extra_port="${lista_puertos[$i]}"
  cat << EXTRA_EOF > "/etc/systemd/system/hcr-${extra_port}.service"
[Unit]
Description=HCR Plain Server (Extra Port $extra_port)
After=network.target ssh.service sshd.service
PartOf=hcr.service

[Service]
Type=simple
User=root
WorkingDirectory=$HCR_DIR
ExecStart=$HCR_BIN --listen :$extra_port --target $ssh_target --transport $HCR_TRANSPORT --max-download-frame $frame_size --download-poll-timeout $HCR_POLL_TIMEOUT
LimitNOFILE=65535
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EXTRA_EOF
  systemctl daemon-reload
  systemctl enable "hcr-${extra_port}.service" >/dev/null 2>&1 || true
  systemctl reset-failed "hcr-${extra_port}.service" >/dev/null 2>&1 || true
  systemctl restart "hcr-${extra_port}.service"
  abrir_puerto_sistema "$extra_port"
done
fi
}

