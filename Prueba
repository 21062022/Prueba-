puerto_valido(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

mostrar_uso_puerto(){
  local p="$1" salida=""
  salida="$(ss -H -ltnp "sport = :$p" 2>/dev/null || true)"$'\n'"$(ss -H -lunp "sport = :$p" 2>/dev/null || true)"
  [ -n "${salida//$'\n'/}" ] && echo "$salida" | sed '/^[[:space:]]*$/d; s/^/    /'
}

puerto_ocupado_por_otro(){
  local p="$1" servicio="${2:-}" salida pid
  salida="$(ss -H -ltnp "sport = :$p" 2>/dev/null || true)"$'\n'"$(ss -H -lunp "sport = :$p" 2>/dev/null || true)"
  salida="$(sed '/^[[:space:]]*$/d' <<< "$salida")"
  [ -z "$salida" ] && return 1
  if [ -n "$servicio" ]; then
    pid="$(systemctl show -p MainPID --value "$servicio" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 0 ] && ! grep -qv "pid=$pid," <<< "$salida"; then
      return 1
    fi
  fi
  return 0
}

puerto_disponible(){
  local p="$1" servicio="$2" ws_service="${WS_SERVICE:-bhttp-ws}"
  puerto_valido "$p" || return 1
  if [ "$servicio" != "$SERVICE" ] && [ -n "$PUERTO" ] && systemctl is-active --quiet "$SERVICE" 2>/dev/null && [ "$p" = "$PUERTO" ]; then return 1; fi
  if [ "$servicio" != "$ws_service" ] && [ -n "$WSPORT" ] && systemctl is-active --quiet "$ws_service" 2>/dev/null && [ "$p" = "$WSPORT" ]; then return 1; fi
  if [ "$servicio" != "$BADVPN_SERVICE" ] && systemctl is-active --quiet "$BADVPN_SERVICE" 2>/dev/null && [ "$p" = "$BADVPN_PORT" ]; then return 1; fi
  ! puerto_ocupado_por_otro "$p" "$servicio"
}

liberar_puerto_para_panel(){
  local p="$1" unidad pid
  if [ "$p" = "22" ] || [ "$p" = "$SSHPORT" ]; then
    fail "El puerto SSH $p está protegido."
    return 1
  fi
  mostrar_uso_puerto "$p"
  info "Liberando el puerto $p..."
  while IFS= read -r unidad; do
    [ -n "$unidad" ] || continue
    pid="$(systemctl show -p MainPID --value "$unidad" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 0 ]; then
      systemctl stop "$unidad" >/dev/null 2>&1 || true
      systemctl disable "$unidad" >/dev/null 2>&1 || true
    fi
  done < <(systemctl list-units --all --type=service --no-legend --plain 2>/dev/null | awk '{print $1}')
  if command -v fuser >/dev/null 2>&1; then
    fuser -k -n tcp "$p" >/dev/null 2>&1 || true
    fuser -k -n udp "$p" >/dev/null 2>&1 || true
  fi
  sleep 1
  ! puerto_ocupado_por_otro "$p"
}

tomar_puerto_para_panel(){
  local p="$1" servicio="$2"
  puerto_valido "$p" || return 1
  puerto_disponible "$p" "$servicio" && return 0
  liberar_puerto_para_panel "$p" || return 1
  puerto_disponible "$p" "$servicio"
}

abrir_puerto_sistema(){
  local p="$1"
  if command -v ufw >/dev/null 2>&1; then
    ufw allow "$p"/tcp >/dev/null 2>&1 || true
    ufw allow "$p"/udp >/dev/null 2>&1 || true
  fi
  if command -v iptables >/dev/null 2>&1; then
    iptables -C INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || iptables -A INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || true
    iptables -C INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || iptables -A INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || true
  fi
}

cerrar_puerto_sistema(){
  local p="$1"
  puerto_valido "$p" || return 0
  if command -v ufw >/dev/null 2>&1; then
    ufw delete allow "$p"/tcp >/dev/null 2>&1 || true
    ufw delete allow "$p"/udp >/dev/null 2>&1 || true
  fi
  if command -v iptables >/dev/null 2>&1; then
    while iptables -C INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null; do iptables -D INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || break; done
    while iptables -C INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null; do iptables -D INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || break; done
  fi
}

