obtener_conexiones_ssh(){
  declare -A conteo=()
  declare -A proc_user=()
  declare -A proc_args=()
  declare -A conn_vista=()
  local line pid owner args usuario peer p
  local ssh_port="${SSHPORT:-22}"
  local proc_snapshot="" sockets=""

  proc_snapshot="$(ps -eo pid=,user=,args= 2>/dev/null || true)"
  while read -r pid owner args; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    proc_user["$pid"]="$owner"
    proc_args["$pid"]="$args"
  done <<< "$proc_snapshot"

  if command -v ss >/dev/null 2>&1; then
    sockets="$(ss -Hntp state established "( sport = :$ssh_port )" 2>/dev/null || true)"
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      peer="$(awk '{print $(NF-1)}' <<< "$line")"
      [ -n "$peer" ] && [ -n "${conn_vista[$peer]:-}" ] && continue
      usuario=""
      while read -r p; do
        [[ "$p" =~ ^[0-9]+$ ]] || continue
        owner="${proc_user[$p]:-}"
        args="${proc_args[$p]:-}"
        if [[ "$args" =~ sshd:[[:space:]]+([^[:space:]@\[]+)([@[:space:]]|$) ]]; then
          usuario="${BASH_REMATCH[1]}"
        elif [[ "$args" == *dropbear* ]] && [ -n "$owner" ] && [ "$owner" != "root" ]; then
          usuario="$owner"
        fi
        if [ -n "$usuario" ] && [ "$usuario" != "root" ]; then break; fi
        usuario=""
      done < <(grep -oE 'pid=[0-9]+' <<< "$line" | cut -d= -f2 | sort -un)
      [ -n "$usuario" ] || continue
      conn_vista["$peer"]=1
      conteo["$usuario"]=$(( ${conteo[$usuario]:-0} + 1 ))
    done <<< "$sockets"
  fi
  for usuario in "${!conteo[@]}"; do
    printf '%s %s\n' "$usuario" "${conteo[$usuario]}"
  done | sort
}

