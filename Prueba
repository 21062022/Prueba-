        read -r -p " Ingresa puerto(s) HCR (ej. 8880 o 8880,2052): " input_ports
        input_ports=${input_ports:-8880}
        local limpiop
        limpiop=$(echo "$input_ports" | tr ',' ' ')
        
        for p in $limpiop; do
          if ! puerto_valido "$p"; then
            fail "Puerto $p inválido."; pausa; continue 2
          fi
          if puerto_ocupado_por_otro "$p"; then
            fail "El puerto $p ya está ocupado por otro servicio. No se puede aceptar."
            pausa; continue 2
          fi
        done

        detener_instancias_hcr
        local main_port
        main_port=$(echo "$limpiop" | awk '{print $1}')
        echo "$limpiop" > "$PORTS_FILE"

        cat << EOF > /etc/systemd/system/hcr.service
[Unit]
Description=HCR Server (Main Port $main_port)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$HCR_DIR
ExecStart=$HCR_BIN --listen :$main_port --target 127.0.0.1:22
LimitNOFILE=65535
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable hcr >/dev/null 2>&1
        systemctl restart hcr
        abrir_puerto_sistema "$main_port"
        ok "¡HCR configurado con éxito en puerto $main_port!"
        pausa ;;
      2)
        detener_instancias_hcr
        ok "Servicio HCR detenido y puertos liberados."
        pausa ;;
      0) return ;;
    esac
  done
}

# --- PANEL PRINCIPAL ---
panel_estado(){
  local up cpu_p ram_p disco_p bhttp_st bad_st hcr_st ws_st
  up="$(uptime -p 2>/dev/null | sed 's/up //')"
  [ -n "$up" ] || up="N/D"
  cpu_p="$(top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4}' 2>/dev/null || echo "1.0")"
  ram_p="$(free | awk '/Mem:/ {printf("%.0f", $3/$2 * 100)}')"
  disco_p="$(df -P / | awk 'NR==2 {print $5}' | tr -d '%')"

  if systemctl is-active --quiet "$SERVICE"; then bhttp_st="${NEON_GREEN}● ONLINE${RESET}"; else bhttp_st="${RED}● OFF${RESET}"; fi
  if systemctl is-active --quiet "$BADVPN_SERVICE"; then bad_st="${NEON_GREEN}● ONLINE${RESET}"; else bad_st="${RED}● OFF${RESET}"; fi
  if systemctl is-active --quiet "hcr"; then hcr_st="${NEON_GREEN}● ONLINE${RESET}"; else hcr_st="${RED}● OFF${RESET}"; fi
  if systemctl is-active --quiet "$WS_SERVICE"; then ws_st="${NEON_GREEN}● ONLINE${RESET}"; else ws_st="${RED}● OFF${RESET}"; fi

  echo -e "  ${NEON_BLUE}┌─ ${WHITE}${BOLD}SISTEMA & RENDIMIENTO PRO${RESET} ${NEON_BLUE}─────────────────────────────┐${RESET}"
  printf "  ${NEON_BLUE}│${RESET} ${GRAY}Uptime:${RESET} %-20s ${GRAY}CPU Uso:${RESET} %-14s ${NEON_BLUE}│${RESET}\n" "$up" "${cpu_p}%"
  printf "  ${NEON_BLUE}│${RESET} ${GRAY}RAM Usada:${RESET} %-18s ${GRAY}Disco:${RESET} %-16s ${NEON_BLUE}│${RESET}\n" "${ram_p}%" "${disco_p}%"
  echo -e "  ${NEON_BLUE}├─ ${WHITE}${BOLD}ESTADO DE PROTOCOLOS ACTIVO${RESET} ${NEON_BLUE}──────────────────────────┤${RESET}"
  printf "  ${NEON_BLUE}│${RESET} BHTTP: %b (%s) | BadVPN: %b (7300/7200)               ${NEON_BLUE}│${RESET}\n" "$bhttp_st" "${PUERTO:-N/A}" "$bad_st"
  printf "  ${NEON_BLUE}│${RESET} WS-SSH: %b (%s) | HCR:    %b                           ${NEON_BLUE}│${RESET}\n" "$ws_st" "${WSPORT:-N/A}" "$hcr_st"
  echo -e "  ${NEON_BLUE}└──────────────────────────────────────────────────────────────${RESET}"
  echo
}

