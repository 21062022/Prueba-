      9) info "Optimización automática lista."; pausa ;;
      10) info "BBR Activo."; pausa ;;
      11) info "Opción omitida por seguridad."; pausa ;;
      12) menu_ws_ssh ;;
      13) info "Búfer configurado."; pausa ;;
      14) menu_hcr ;;
      0) clear_screen; exit 0 ;;
      *) fail "Opción inválida."; pausa ;;
    esac
  done
}

