instalar_badvpn(){
  local bin=""
  for x in /usr/bin/badvpn-udpgw /usr/local/bin/badvpn-udpgw; do
    [ -x "$x" ] && { bin="$x"; break; }
  done
  [ -z "$bin" ] && bin="$(command -v badvpn-udpgw 2>/dev/null || true)"
  if [ -z "$bin" ]; then
    local log="$CONFIG_DIR/badvpn-install.log"
    mkdir -p "$CONFIG_DIR"
    DEBIAN_FRONTEND=noninteractive apt-get update >> "$log" 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y badvpn iptables-persistent >> "$log" 2>&1 || true
    for x in /usr/bin/badvpn-udpgw /usr/local/bin/badvpn-udpgw; do
      [ -x "$x" ] && { bin="$x"; break; }
    done
    bin="$(command -v badvpn-udpgw 2>/dev/null || true)"
  fi
  if [ -z "$bin" ]; then
    fail "No se pudo instalar badvpn-udpgw."
    return 1
  fi
  cat > "$BADVPN_UNIT" <<EOF
[Unit]
Description=BadVPN UDP Gateway (7300 y 7200)
After=network.target

[Service]
Type=simple
User=root
ExecStart=$bin --listen-addr 0.0.0.0:$BADVPN_PORT --max-clients 1000 --max-connections 2000
ExecStartPost=/usr/local/bin/badvpn-secondary.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

  cat > /usr/local/bin/badvpn-secondary.sh <<EOF
#!/usr/bin/env bash
p=\$( [ "$BADVPN_PORT" = "7300" ] && echo 7200 || echo 7300 )
if ! ss -tulnp | grep -q "\b\$p\b"; then
  $bin --listen-addr 0.0.0.0:\$p --max-clients 1000 --max-connections 2000 &
fi
EOF
  chmod +x /usr/local/bin/badvpn-secondary.sh
  systemctl daemon-reload
}

